# .env.example — ρυθμίσεις για το docker-compose.yml (ΟΛΟΚΛΗΡΟ το stack)
# --------------------------------------------------------------------
# Αντέγραψε σε .env και συμπλήρωσε τα τρία υποχρεωτικά μυστικά:
#
#     cp .env.example .env
#     docker compose up -d --build
#     -> http://localhost:8080
#
# ΔΙΑΦΟΡΑ ΑΠΟ ΤΑ ΑΛΛΑ .env.example:
#   backend/.env.example  -> για `python app.py` απευθείας στο μηχάνημά σου
#   frontend/.env.example -> για `npm run dev`
#   ΑΥΤΟ ΕΔΩ              -> για το docker compose (περνά στα containers)
# --------------------------------------------------------------------

# ==== ΥΠΟΧΡΕΩΤΙΚΑ ====================================================
# Το compose ΔΕΝ ξεκινά χωρίς αυτά τα τρία (σκόπιμα — δες
# validate_production_config στο backend/config.py).
#
# Παρήγαγε τρεις διαφορετικές τυχαίες τιμές:
#     openssl rand -base64 32
#
# ⚠️ Αν αλλάξει το ENCRYPTION_KEY, τα ήδη αποθηκευμένα κλειδιά ΑΑΔΕ στη
# βάση γίνονται μη αναγνώσιμα και πρέπει να ξαναμπούν από τις Ρυθμίσεις.
# Κράτα το κάπου ασφαλή ΜΑΖΙ με τα backups της βάσης — backup χωρίς αυτό
# το κλειδί δεν επαναφέρει τα credentials ΑΑΔΕ.
POSTGRES_PASSWORD=
JWT_SECRET_KEY=
ENCRYPTION_KEY=

# ==== Δίκτυο / origins ===============================================
# Θύρα του host απ' όπου ανοίγει η εφαρμογή.
APP_PORT=8080

# Το origin απ' όπου σερβίρεται το frontend. Πρέπει να ταιριάζει με το
# APP_PORT παραπάνω. Με πραγματικό domain πίσω από HTTPS reverse proxy,
# βάλε εδώ το https://... (και τα δύο παρακάτω μαζί).
CORS_ORIGINS=http://localhost:8080
# Χτίζει τα links /verify-email και /reset-password μέσα στα emails.
FRONTEND_URL=http://localhost:8080

# Άφησέ το ΚΕΝΟ: το frontend καλεί σχετικά /api/... και το nginx τα
# προωθεί στο backend (ένα origin, μηδέν CORS). Όρισέ το μόνο αν βάλεις
# το backend σε ξεχωριστό domain.
# ΠΡΟΣΟΧΗ: build-time μεταβλητή του Vite — αλλαγή απαιτεί
# `docker compose build frontend`, δεν αρκεί restart.
VITE_API_URL=

# ==== ΑΑΔΕ ===========================================================
# true  = MockAadeService (καμία πραγματική κλήση) — ΞΕΚΙΝΑ ΜΕ ΑΥΤΟ
# false = RealAadeService (χρειάζεται credentials στις «Ρυθμίσεις ΑΑΔΕ»)
# Μπορεί να γίνει override ανά workshop από την ίδια την εφαρμογή.
USE_MOCK_AADE=true

# dev = δοκιμαστικό περιβάλλον ΑΑΔΕ, prod = παραγωγή. ΞΕΚΙΝΑ ΜΕ dev.
AADE_ENV=dev

# Αριθμός εγκατάστασης του συνεργείου (0 = έδρα/κεντρικό).
BRANCH_NUMBER=0

# ==== Συνδρομές ======================================================
# Μέρες δωρεάν δοκιμής από την εγγραφή. Μετά, το backend μπλοκάρει με 402
# μέχρι χειροκίνητη ενεργοποίηση μέσω των /api/admin/* endpoints.
TRIAL_DAYS=14

# Κλειδί για τα /api/admin/* (χειροκίνητη έγκριση συνδρομής μετά από
# τραπεζική μεταφορά). ΚΕΝΟ = τα admin endpoints είναι ΚΛΕΙΣΤΑ.
# Στέλνεται στο header X-Admin-Key.
ADMIN_KEY=

# ==== Προαιρετικά ====================================================
# Αναγνώριση πινακίδας μέσω Plate Recognizer (~2500 δωρεάν/μήνα).
# Χωρίς αυτό, η εφαρμογή πέφτει στο δωρεάν tesseract (τοπικά στον browser).
PLATE_RECOGNIZER_TOKEN=
PLATE_RECOGNIZER_REGIONS=gr

# Email (Resend). Χωρίς RESEND_API_KEY δεν στέλνεται πραγματικό email —
# το link καταγράφεται στα logs (`docker compose logs backend`), ώστε να
# δοκιμάζεται η ροή εγγραφής/επαναφοράς κωδικού.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Error tracking. Χωρίς αυτό, τα production bugs φαίνονται μόνο αν ψάξεις
# χειροκίνητα τα logs.
SENTRY_DSN=

# Συγκεντρωτικά OCR metrics από πολλές εγκαταστάσεις (δες telemetry-server/).
TELEMETRY_URL=
TELEMETRY_KEY=
