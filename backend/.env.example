# Αντέγραψε αυτό το αρχείο σε .env και προσάρμοσε τις τιμές.

# Περιβάλλον Flask
FLASK_ENV=development

# Σύνδεση βάσης. Default: τοπικό SQLite (backend/dcl.db)
DATABASE_URL=sqlite:///dcl.db

# Χρήση mock ΑΑΔΕ (true) ή πραγματικού client (false).
# - true  : MockAadeService (καμία πραγματική κλήση)
# - false : RealAadeService (πραγματική σύνδεση ΑΑΔΕ — χρειάζεται credentials
#           στις «Ρυθμίσεις ΑΑΔΕ» + XSD στο aade_specs/)
USE_MOCK_AADE=true

# Αριθμός εγκατάστασης του συνεργείου (0 = έδρα/κεντρικό)
BRANCH_NUMBER=0

# CORS origins για τα /api/* routes. Default "*" (βολικό για tunnels στο
# dev/testing). ΓΙΑ PRODUCTION όρισε το πραγματικό origin του frontend
# (π.χ. https://app.mygarage.gr) — comma-separated αν είναι παραπάνω από ένα.
# CORS_ORIGINS=https://app.mygarage.gr

# Debugger του Flask/Werkzeug — ΠΟΤΕ true σε production (arbitrary code
# execution μέσω της error page). Default: ίδιο με FLASK_ENV=development.
# FLASK_DEBUG=false

# --- Auth (multi-tenant) ---
# ΥΠΟΧΡΕΩΤΙΚΟ σε production: μυστικό για την υπογραφή των JWT tokens.
# JWT_SECRET_KEY=

# ΥΠΟΧΡΕΩΤΙΚΟ σε production: κλειδί κρυπτογράφησης του aade_subscription_key
# στη βάση (encryption at rest). Οτιδήποτε αλφαριθμητικό δουλεύει (περνάει
# από SHA-256 πριν χρησιμοποιηθεί) — π.χ. `openssl rand -base64 32`.
# Αν αλλάξει, τα ήδη αποθηκευμένα κλειδιά ΑΑΔΕ γίνονται μη αναγνώσιμα (θα
# χρειαστεί να τα ξαναμπεί ο χρήστης από τις Ρυθμίσεις).
# ENCRYPTION_KEY=

# Κλειδί για τα /api/admin/* endpoints (χειροκίνητη έγκριση συνδρομών μετά
# από τραπεζική μεταφορά — δεν υπάρχει Stripe/αυτόματη χρέωση). Χωρίς αυτό
# τα admin endpoints είναι ΚΛΕΙΣΤΑ. Στέλνεται στο header X-Admin-Key.
# ADMIN_KEY=

# --- Πραγματική ΑΑΔΕ (όταν USE_MOCK_AADE=false) ---
# Περιβάλλον: dev (δοκιμαστικό) ή prod (παραγωγή). ΞΕΚΙΝΑ ΜΕ dev.
AADE_ENV=dev
# Προαιρετικό override του base URL (αλλιώς επιλέγεται από το AADE_ENV):
#   dev  -> https://mydataapidev.aade.gr/DCL/
#   prod -> https://mydatapi.aade.gr/DCL/
# AADE_BASE_URL=

# --- Αναγνώριση πινακίδας μέσω ALPR (Plate Recognizer) ---
# Δωρεάν API key (~2500 αναγνωρίσεις/μήνα): https://platerecognizer.com
# Το token μένει ΜΟΝΟ εδώ (backend) — ΠΟΤΕ σε VITE_* env var, γιατί αυτές
# καταλήγουν στο public JS bundle του frontend.
# Χωρίς αυτό, το /api/ocr/plate γυρνά 503 και η εφαρμογή πέφτει στο δωρεάν
# tesseract recognizer (VITE_RECOGNIZER=tesseract, το default).
# PLATE_RECOGNIZER_TOKEN=
# PLATE_RECOGNIZER_URL=https://api.platerecognizer.com/v1/plate-reader/
# PLATE_RECOGNIZER_REGIONS=gr

# --- Email (επιβεβαίωση email εγγραφής + επαναφορά κωδικού, μέσω Resend
# REST API: https://resend.com) ---
# Χωρίς RESEND_API_KEY, ΔΕΝ στέλνεται πραγματικό email — το backend
# καταγράφει το περιεχόμενο (με το link) στο log, ώστε η ροή να δοκιμάζεται
# τοπικά πριν φτιαχτεί λογαριασμός Resend.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Ψηφιακό Πελατολόγιο <onboarding@resend.dev>
# Origin του frontend — χτίζει τα links /verify-email και /reset-password
# μέσα στα emails.
# FRONTEND_URL=http://localhost:3000

# --- Error tracking (προαιρετικό) ---
# Αν οριστεί SENTRY_DSN, κάθε unhandled exception προωθείται στο Sentry
# (δωρεάν tier). Χωρίς αυτό, production bugs φαίνονται ΜΟΝΟ αν ψάξεις
# χειροκίνητα τα Render logs.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>

# --- Rate limiting (προαιρετικό) ---
# Χωρίς αυτό, in-memory storage ΑΝΑ gunicorn worker (δες backend/auth.py) —
# εντάξει για τοπική ανάπτυξη, ΟΧΙ για production με >1 worker.
# REDIS_URL=redis://localhost:6379

# --- Telemetry OCR (προαιρετικό) ---
# Αν οριστεί TELEMETRY_URL, κάθε μετρική OCR (κάθε σάρωση πινακίδας)
# προωθείται ΚΑΙ στον δικό σου κεντρικό server (δες telemetry-server/),
# ώστε να βλέπεις συγκεντρωτικά δεδομένα από ΟΛΕΣ τις εγκαταστάσεις πελατών
# χωρίς να χρειάζεσαι πρόσβαση στο μηχάνημα του καθενός.
# TELEMETRY_URL=https://<το-δικό-σου-deployment>/ingest
# TELEMETRY_KEY=<ίδιο με το INGEST_KEY του telemetry-server>

