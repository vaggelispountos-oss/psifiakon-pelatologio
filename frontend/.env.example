# Αντέγραψε σε .env και προσάρμοσε αν χρειάζεται.
#
# Το backend (Flask) τρέχει στο 5001 (ΟΧΙ 5000 — στο macOS το 5000 το κρατάει
# το AirPlay Receiver).
#
# ΣΗΜΕΙΩΣΗ: Το Vite διαβάζει μεταβλητές με πρόθεμα VITE_ (μέσω
# import.meta.env), όχι REACT_APP_. Χρησιμοποιούμε VITE_API_URL.
VITE_API_URL=http://localhost:5001
