{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "cwd": "frontend"
    },
    {
      "name": "frontend-pwa-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "preview", "--", "--port", "4173"],
      "port": 4173,
      "cwd": "frontend"
    },
    {
      "name": "backend-dev",
      "runtimeExecutable": "venv/bin/python",
      "runtimeArgs": ["app.py"],
      "port": 5001,
      "cwd": "backend"
    }
  ]
}
