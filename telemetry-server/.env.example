# Αντέγραψε σε .env και συμπλήρωσε.
#
# ⚠️ Αν INGEST_KEY / DASHBOARD_KEY λείπουν, τα routes αρνούνται να
# λειτουργήσουν (503) ΕΚΤΟΣ αν FLASK_ENV=development (τοπικό dev). Δεν
# υπάρχει πλέον "ανοιχτό by accident" σενάριο σε production.

# Ρητά development mode — επιτρέπει /ingest και /dashboard ΧΩΡΙΣ κλειδί, ΜΟΝΟ
# για τοπικές δοκιμές. ΠΟΤΕ σε δημόσιο deployment.
FLASK_ENV=development

# Μυστικό που ΚΑΘΕ εγκατάσταση-πελάτης πρέπει να στέλνει στο header
# X-Telemetry-Key ώστε να γίνεται δεκτή η μετρική. Πρέπει να ταιριάζει με το
# TELEMETRY_KEY στο backend/.env ΚΑΘΕ εγκατάστασης.
INGEST_KEY=choose-a-long-random-secret

# Κλειδί για να βλέπεις ΕΣΥ το /dashboard (?key=...).
DASHBOARD_KEY=choose-another-long-random-secret

# Βάση δεδομένων. Default: τοπικό SQLite αρχείο (καλό για αρχή/λίγους
# πελάτες). Για παραγωγή σε Render/Railway, βάλε Postgres URL εδώ.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

PORT=5050
